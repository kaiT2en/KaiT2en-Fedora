# kait2en-update reads this file from GitHub. A changed path selects every
# line whose prefix matches it. Keep the lines in installation order.
#
# name                        [if=installed-path] path prefixes...
#
# install-*.sh and rebuild-initramfs.sh also depend on their own script.
# app:<name> runs install-apps.sh for that app only. if= makes an optional
# part count only where it is installed. core changes ask for a full run.

core                          scripts/fedora/lib.sh scripts/fedora/install.sh
command-helpers               scripts/fedora/kait2en-multicall
install-dependencies.sh
install-kernel-args.sh
install-dkms-modules.sh       modules/ t2-services/t2-ave/kernel/ third-party/linux-apfs-rw/
install-kernel-source.sh
install-macos-mount.sh
install-gpu-runtime-pm.sh     patches/runtime/gpu-runtime-pm/
install-wireless.sh           patches/runtime/wireless/
install-alsa-ucm.sh           modules/t2bce_audio-alsa-ucm-conf/
install-dsp.sh                dsp/
install-acpi-fixes.sh         scripts/fedora/acpi-autofix.py
install-plymouth-theme.sh     assets/plymouth/
install-gdm-branding.sh       assets/gdm/
install-suspend-service.sh    scripts/fedora/kait2en-suspend.sh
install-rtc-sync.sh
app:assets                    scripts/fedora/install-apps.sh assets/kait2en-app-logo.png assets/kait2en-app-logo-light.png assets/fonts/
app:t2-fan-control            apps/t2-fan-control/
app:t2-smc-control            apps/t2-smc-control/
app:t2-power-explorer         apps/t2-power-explorer/
app:t2-force-click            apps/t2-force-click/
app:t2-debug                  apps/t2-debug/
app:t2-airshare               apps/t2-airshare/
app:t2-drop                   apps/t2-drop/
app:t2-kbd-backlight          apps/t2-kbd-backlight/
app:t2-touchbar               if=/usr/local/bin/kait2en-touchbar apps/t2-touchbar/
app:t2-journal                t2-services/t2-journal/ packaging/lifecycle/
app:gpu-control               apps/t2-dgpu-control/ apps/t2-hybrid-gpu-control/
app:t2-zone-power             apps/t2-zone-power/
app:kait2en-update            apps/kait2en-update/
app:t2-kernel-builder         apps/t2-kernel-builder/
app:t2-power-tune             apps/t2-power-tune/
app:t2-sidecar                apps/t2-sidecar/
install-t2-services-common.sh t2-services/shared/ packaging/lifecycle/
install-t2-remote.sh          t2-services/t2-ave/Cargo.toml t2-services/t2-ave/Cargo.lock t2-services/t2-ave/Makefile t2-services/t2-ave/cli/ t2-services/t2-ave/daemon/ t2-services/t2-ave/integration/ t2-services/t2-ave/packaging/ t2-services/t2-ave/protocols/ packaging/lifecycle/
install-touchid.sh            t2-services/t2-touchid/ packaging/lifecycle/
rebuild-initramfs.sh
install-autobrightness.sh     if=/usr/local/bin/t2-autobrightness t2-services/t2-autobrightness/
install-vornehm.sh            if=~/.local/share/gnome-shell/extensions/kait2en-vornehm@kait2en assets/vornehm/

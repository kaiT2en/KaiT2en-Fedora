config T2_AVE
	tristate "Apple T2 audio video encoder support"
	depends on APPLE_T2_BRIDGE
	depends on MEDIA_SUPPORT && VIDEO_DEV
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_VMALLOC
	help
	  Driver for the Apple T2 video encoder (AVE), exposed as a V4L2
	  memory-to-memory device.

	  If built as a module, it is called t2-ave.

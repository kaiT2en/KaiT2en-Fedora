From: Andre Eikmeyer <andre.eikmeyer@kait2en.org>
Subject: [PATCH] thunderbolt: add Titan Ridge and Ice Lake RTD3 on Apple T2 Macs

Titan Ridge on T2 Macs has no RTD3 under Linux, the idle controller stays
powered. Its PCIe root ports keep their PHY on, which holds the package
at PC7. The firmware only powers the controller down through the Darwin
_PS3 and _PS0 methods of its ports after RTPC, and it turns the rails
back on from a child's _PS0, an order the PCI core cannot follow.

Take the Titan Ridge root ports over from pcieport and run the macOS RTD3
sequence on them. Keep the bridges below in D0, let the host router
runtime suspend while the controller is unused and leave the link
controller alone on runtime suspend as macOS does.

Ice Lake integrated routers are not USB4, and on Apple systems the
firmware connection manager is not used, so the software connection
manager never enables runtime PM for them and the NHI stays in D0. The
firmware connection manager reports RTD3 for these routers, enable
runtime PM for them in the software connection manager as well.

This is an interim downstream solution so the change ships as an out of
tree module. Upstream it belongs into a PCI quirk for these root ports
that keeps them with pcieport.

Signed-off-by: Andre Eikmeyer <andre.eikmeyer@kait2en.org>
---
 drivers/thunderbolt/Makefile |   2 +-
 drivers/thunderbolt/apple.c  | 618 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 drivers/thunderbolt/pci.c    |  11 +-
 drivers/thunderbolt/switch.c |   7 +
 drivers/thunderbolt/tb.c     |  78 +++++++++++++++-
 drivers/thunderbolt/tb.h     |  27 +++++
 6 files changed, 736 insertions(+), 7 deletions(-)

diff --git a/drivers/thunderbolt/Makefile b/drivers/thunderbolt/Makefile
index beb054c..a3f0efc 100644
--- a/drivers/thunderbolt/Makefile
+++ b/drivers/thunderbolt/Makefile
@@ -5,7 +5,7 @@ thunderbolt-objs := nhi.o ctl.o tb.o switch.o cap.o pci.o path.o tunnel.o eeprom
 thunderbolt-objs += domain.o dma_port.o icm.o property.o xdomain.o lc.o tmu.o usb4.o
 thunderbolt-objs += usb4_port.o nvm.o retimer.o quirks.o clx.o
 
-thunderbolt-${CONFIG_ACPI} += acpi.o
+thunderbolt-${CONFIG_ACPI} += acpi.o apple.o
 thunderbolt-$(CONFIG_DEBUG_FS) += debugfs.o
 thunderbolt-$(CONFIG_USB4_CONFIGFS) += configfs.o
 thunderbolt-${CONFIG_USB4_KUNIT_TEST} += test.o
diff --git a/drivers/thunderbolt/apple.c b/drivers/thunderbolt/apple.c
new file mode 100644
index 0000000..b85bea5
--- /dev/null
+++ b/drivers/thunderbolt/apple.c
@@ -0,0 +1,618 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/acpi.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/platform_data/x86/apple.h>
+#include <linux/pm_runtime.h>
+#include <linux/usb.h>
+
+#include "nhi.h"
+#include "tb.h"
+
+#define TB_APPLE_DSB_NHI	PCI_DEVFN(0, 0)
+#define TB_APPLE_DSB_XHCI	PCI_DEVFN(2, 0)
+#define TB_APPLE_AUTOSUSPEND_MS	1000
+
+struct tb_apple_port {
+	struct pci_dev *port;
+	struct pci_ops *ops;
+	struct pci_dev *upsb;
+	struct pci_dev *dsb_nhi;
+	struct pci_dev *dsb_xhci;
+	struct pci_dev *nhi;
+	struct pci_dev *xhci;
+	struct device_link *links[3];
+	bool off;
+};
+
+/* Config accesses below an unpowered port raise a CATERR, drop them. */
+/* Buses added by hotplug inherit these ops, so find the port from the bus. */
+static struct tb_apple_port *tb_apple_bus_port(struct pci_bus *bus)
+{
+	while (bus->parent && !pci_is_root_bus(bus->parent))
+		bus = bus->parent;
+
+	return bus->self ? pci_get_drvdata(bus->self) : NULL;
+}
+
+static int tb_apple_read(struct pci_bus *bus, unsigned int devfn, int where,
+			 int size, u32 *val)
+{
+	struct tb_apple_port *tap = tb_apple_bus_port(bus);
+
+	if (!tap || READ_ONCE(tap->off)) {
+		PCI_SET_ERROR_RESPONSE(val);
+		return tap ? PCIBIOS_SUCCESSFUL : PCIBIOS_DEVICE_NOT_FOUND;
+	}
+
+	return tap->ops->read(bus, devfn, where, size, val);
+}
+
+static int tb_apple_write(struct pci_bus *bus, unsigned int devfn, int where,
+			  int size, u32 val)
+{
+	struct tb_apple_port *tap = tb_apple_bus_port(bus);
+
+	if (!tap)
+		return PCIBIOS_DEVICE_NOT_FOUND;
+	if (READ_ONCE(tap->off))
+		return PCIBIOS_SUCCESSFUL;
+
+	return tap->ops->write(bus, devfn, where, size, val);
+}
+
+static struct pci_ops tb_apple_ops = {
+	.read = tb_apple_read,
+	.write = tb_apple_write,
+};
+
+/* Callers hold pci_lock_rescan_remove(), no bus is added or removed. */
+static void tb_apple_swap_ops(struct pci_bus *bus, struct pci_ops *from,
+			      struct pci_ops *to)
+{
+	struct pci_bus *child;
+
+	if (bus->ops == from)
+		bus->ops = to;
+
+	list_for_each_entry(child, &bus->children, node)
+		tb_apple_swap_ops(child, from, to);
+}
+
+static void tb_apple_wrap_buses(struct tb_apple_port *tap)
+{
+	tap->ops = tap->port->subordinate->ops;
+	tb_apple_swap_ops(tap->port->subordinate, tap->ops, &tb_apple_ops);
+}
+
+static void tb_apple_unwrap_buses(struct tb_apple_port *tap)
+{
+	tb_apple_swap_ops(tap->port->subordinate, &tb_apple_ops, tap->ops);
+}
+
+static int tb_apple_set_power(struct pci_dev *pdev, int state)
+{
+	int ret;
+
+	ret = acpi_device_set_power(ACPI_COMPANION(&pdev->dev), state);
+	if (ret)
+		pci_warn(pdev, "cannot set ACPI power state D%d: %d\n",
+			 state, ret);
+	return ret;
+}
+
+static void tb_apple_rtpc(struct pci_dev *pdev, bool on)
+{
+	acpi_status status;
+
+	status = acpi_execute_simple_method(ACPI_HANDLE(&pdev->dev), "RTPC", on);
+	if (ACPI_FAILURE(status))
+		pci_warn(pdev, "cannot evaluate RTPC(%d): %s\n", on,
+			 acpi_format_exception(status));
+}
+
+#define tb_apple_for_each_dev(tap, pdev)				\
+	list_for_each_entry(pdev, &(tap)->upsb->subordinate->devices,	\
+			    bus_list)
+
+static void tb_apple_set_tree_state(struct tb_apple_port *tap,
+				    pci_power_t state)
+{
+	struct pci_dev *dsb;
+
+	tap->upsb->current_state = state;
+	tb_apple_for_each_dev(tap, dsb)
+		dsb->current_state = state;
+}
+
+static int tb_apple_usb_dev(struct usb_device *udev, void *data)
+{
+	return udev->parent && udev->bus->controller == data;
+}
+
+/* Autosuspended USB devices and hotplug port devices need the rails. */
+static bool tb_apple_busy(struct tb_apple_port *tap)
+{
+	struct pci_dev *dsb;
+
+	if (usb_for_each_dev(&tap->xhci->dev, tb_apple_usb_dev))
+		return true;
+
+	tb_apple_for_each_dev(tap, dsb)
+		if (dsb->subordinate && dsb != tap->dsb_nhi &&
+		    dsb != tap->dsb_xhci &&
+		    !list_empty(&dsb->subordinate->devices))
+			return true;
+
+	return false;
+}
+
+static void tb_apple_pme_poll(struct tb_apple_port *tap, bool on)
+{
+	pci_power_t state = on ? PCI_D3hot : PCI_D3cold;
+
+	tap->nhi->pme_poll = on;
+	tap->xhci->pme_poll = on;
+	tap->nhi->current_state = state;
+	tap->xhci->current_state = state;
+}
+
+/*
+ * As IOPCIFamily: _PS3 then PMCSR D3 on the way down, bus numbers, _PS0,
+ * PMCSR D0 and the saved config space on the way up.
+ */
+static void tb_apple_pmcsr(struct pci_dev *pdev, u16 state)
+{
+	u16 ctrl;
+
+	if (!pdev->pm_cap)
+		return;
+
+	pci_read_config_word(pdev, pdev->pm_cap + PCI_PM_CTRL, &ctrl);
+	if (state == PCI_D0)
+		ctrl = PCI_PM_CTRL_PME_STATUS | PCI_D0;
+	else
+		ctrl = (ctrl & ~(PCI_PM_CTRL_STATE_MASK |
+				 PCI_PM_CTRL_PME_STATUS)) | state;
+	pci_write_config_word(pdev, pdev->pm_cap + PCI_PM_CTRL, ctrl);
+	msleep(10);
+}
+
+static bool tb_apple_has_ps(struct pci_dev *pdev)
+{
+	struct acpi_device *adev = ACPI_COMPANION(&pdev->dev);
+
+	return adev && acpi_device_power_manageable(adev);
+}
+
+static void tb_apple_bridge_off(struct pci_dev *pdev)
+{
+	if (tb_apple_has_ps(pdev))
+		tb_apple_set_power(pdev, ACPI_STATE_D3_HOT);
+	tb_apple_pmcsr(pdev, PCI_D3hot);
+	pdev->current_state = PCI_D3hot;
+}
+
+static void tb_apple_bridge_on(struct pci_dev *pdev)
+{
+	u32 saved = pdev->saved_config_space[PCI_PRIMARY_BUS / 4];
+	u32 bus;
+
+	pci_read_config_dword(pdev, PCI_PRIMARY_BUS, &bus);
+	if (!(bus & 0xffffff))
+		pci_write_config_dword(pdev, PCI_PRIMARY_BUS, saved);
+
+	if (tb_apple_has_ps(pdev))
+		tb_apple_set_power(pdev, ACPI_STATE_D0);
+	tb_apple_pmcsr(pdev, PCI_D0);
+	pci_restore_state(pdev);
+	pdev->current_state = PCI_D0;
+}
+
+/*
+ * RTPC releases both functions, the root port _PS3 then takes the link to
+ * L2/L3, powers the PEG PHY down and cuts the rails.
+ */
+static int tb_apple_power_off(struct tb_apple_port *tap)
+{
+	struct pci_dev *dsb;
+	int ret;
+
+	if (tb_apple_busy(tap)) {
+		pm_runtime_mark_last_busy(&tap->port->dev);
+		return -EBUSY;
+	}
+
+	/* PME polling would touch the functions while their links go down. */
+	tb_apple_pme_poll(tap, false);
+
+	pci_save_state(tap->upsb);
+	tb_apple_for_each_dev(tap, dsb)
+		pci_save_state(dsb);
+
+	ret = pci_save_state(tap->port);
+	if (ret) {
+		tb_apple_pme_poll(tap, true);
+		return ret;
+	}
+
+	tb_apple_rtpc(tap->nhi, false);
+	tb_apple_rtpc(tap->xhci, false);
+
+	/* xHCI rail first, a bounce of the other rail raises a hotplug GPE. */
+	tb_apple_bridge_off(tap->dsb_xhci);
+	tb_apple_for_each_dev(tap, dsb)
+		if (dsb != tap->dsb_xhci)
+			tb_apple_bridge_off(dsb);
+	tb_apple_bridge_off(tap->upsb);
+
+	ret = tb_apple_set_power(tap->port, ACPI_STATE_D3_HOT);
+	if (ret) {
+		tb_apple_bridge_on(tap->upsb);
+		tb_apple_for_each_dev(tap, dsb)
+			tb_apple_bridge_on(dsb);
+		tb_apple_rtpc(tap->nhi, true);
+		tb_apple_rtpc(tap->xhci, true);
+		tb_apple_pme_poll(tap, true);
+		return ret;
+	}
+
+	WRITE_ONCE(tap->off, true);
+	tb_apple_set_tree_state(tap, PCI_D3cold);
+
+	tap->port->current_state = PCI_D3hot;
+	pci_info(tap->port, "Thunderbolt controller powered off\n");
+
+	return 0;
+}
+
+/* The root port _PS0 already ran, the upstream port _PS0 turns the rails on. */
+static void tb_apple_power_on(struct tb_apple_port *tap)
+{
+	struct pci_dev *dsb;
+
+	tb_apple_rtpc(tap->nhi, true);
+	tb_apple_rtpc(tap->xhci, true);
+
+	WRITE_ONCE(tap->off, false);
+	tb_apple_bridge_on(tap->upsb);
+	tb_apple_for_each_dev(tap, dsb)
+		tb_apple_bridge_on(dsb);
+
+	tap->nhi->pme_poll = true;
+	tap->xhci->pme_poll = true;
+
+	pci_info(tap->port, "Thunderbolt controller powered on\n");
+}
+
+static int tb_apple_runtime_suspend(struct device *dev)
+{
+	return tb_apple_power_off(dev_get_drvdata(dev));
+}
+
+static int tb_apple_runtime_resume(struct device *dev)
+{
+	struct tb_apple_port *tap = dev_get_drvdata(dev);
+
+	if (tap->off)
+		tb_apple_power_on(tap);
+	return 0;
+}
+
+/* System sleep runs with the controller on, as without this driver. */
+static int tb_apple_prepare(struct device *dev)
+{
+	struct tb_apple_port *tap = dev_get_drvdata(dev);
+
+	pm_runtime_resume(&tap->nhi->dev);
+	pm_runtime_resume(&tap->xhci->dev);
+	return 0;
+}
+
+/* Keep the root port out of D3 across system sleep. */
+static int tb_apple_suspend_noirq(struct device *dev)
+{
+	return pci_save_state(to_pci_dev(dev));
+}
+
+static const struct dev_pm_ops tb_apple_pm_ops = {
+	.prepare = tb_apple_prepare,
+	.suspend_noirq = tb_apple_suspend_noirq,
+	.freeze_noirq = tb_apple_suspend_noirq,
+	.poweroff_noirq = tb_apple_suspend_noirq,
+	.runtime_suspend = tb_apple_runtime_suspend,
+	.runtime_resume = tb_apple_runtime_resume,
+};
+
+/* A plug while the controller is off raises a Bus Check on the NHI. */
+static void tb_apple_notify(acpi_handle handle, u32 event, void *data)
+{
+	struct tb_apple_port *tap = data;
+
+	if (event != ACPI_NOTIFY_BUS_CHECK)
+		return;
+
+	pm_request_resume(&tap->nhi->dev);
+	pm_request_resume(&tap->xhci->dev);
+}
+
+static int tb_apple_link(struct tb_apple_port *tap, struct pci_dev *consumer,
+			 struct pci_dev *supplier, int i)
+{
+	pm_runtime_get_sync(&consumer->dev);
+	tap->links[i] = device_link_add(&consumer->dev, &supplier->dev,
+					DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME |
+					DL_FLAG_RPM_ACTIVE);
+	pm_runtime_put(&consumer->dev);
+
+	return tap->links[i] ? 0 : -EINVAL;
+}
+
+static void tb_apple_unlink(struct tb_apple_port *tap)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(tap->links); i++) {
+		if (tap->links[i])
+			device_link_del(tap->links[i]);
+		tap->links[i] = NULL;
+	}
+}
+
+static struct pci_dev *tb_apple_child(struct pci_dev *bridge,
+				      unsigned int devfn)
+{
+	struct pci_dev *pdev;
+
+	if (!bridge || !bridge->subordinate)
+		return NULL;
+
+	list_for_each_entry(pdev, &bridge->subordinate->devices, bus_list)
+		if (pdev->devfn == devfn)
+			return pdev;
+
+	return NULL;
+}
+
+static bool tb_apple_has_method(struct pci_dev *pdev, char *method)
+{
+	acpi_handle handle = pdev ? ACPI_HANDLE(&pdev->dev) : NULL;
+
+	return handle && acpi_has_method(handle, method);
+}
+
+static bool tb_apple_find(struct pci_dev *port, struct tb_apple_port *tap)
+{
+	if (!x86_apple_machine || port->vendor != PCI_VENDOR_ID_INTEL ||
+	    pci_pcie_type(port) != PCI_EXP_TYPE_ROOT_PORT)
+		return false;
+
+	tap->port = port;
+	tap->upsb = tb_apple_child(port, PCI_DEVFN(0, 0));
+	tap->dsb_nhi = tb_apple_child(tap->upsb, TB_APPLE_DSB_NHI);
+	tap->dsb_xhci = tb_apple_child(tap->upsb, TB_APPLE_DSB_XHCI);
+	tap->nhi = tb_apple_child(tap->dsb_nhi, PCI_DEVFN(0, 0));
+	tap->xhci = tb_apple_child(tap->dsb_xhci, PCI_DEVFN(0, 0));
+
+	if (!tap->nhi || !tap->xhci ||
+	    (tap->nhi->device != PCI_DEVICE_ID_INTEL_TITAN_RIDGE_2C_NHI &&
+	     tap->nhi->device != PCI_DEVICE_ID_INTEL_TITAN_RIDGE_4C_NHI))
+		return false;
+
+	return tb_apple_has_method(port, "_PS3") &&
+	       tb_apple_has_method(tap->upsb, "_PS0") &&
+	       tb_apple_has_method(tap->dsb_nhi, "_PS3") &&
+	       tb_apple_has_method(tap->dsb_xhci, "_PS3") &&
+	       tb_apple_has_method(tap->nhi, "RTPC") &&
+	       tb_apple_has_method(tap->xhci, "RTPC");
+}
+
+/*
+ * pcieport would run the Darwin _PS3 and _PS0 of the bridges in the wrong
+ * order, keep them in D0 and runtime active.
+ */
+static void tb_apple_hold(struct pci_dev *pdev, bool hold)
+{
+	if (hold) {
+		pdev->dev_flags |= PCI_DEV_FLAGS_NO_D3;
+		pm_runtime_forbid(&pdev->dev);
+	} else {
+		pdev->dev_flags &= ~PCI_DEV_FLAGS_NO_D3;
+		if (pdev->dev.driver)
+			pm_runtime_allow(&pdev->dev);
+	}
+}
+
+static void tb_apple_hold_bridges(struct tb_apple_port *tap, bool hold)
+{
+	struct pci_dev *dsb;
+
+	tb_apple_for_each_dev(tap, dsb)
+		tb_apple_hold(dsb, hold);
+	tb_apple_hold(tap->upsb, hold);
+}
+
+static int tb_apple_probe(struct pci_dev *port, const struct pci_device_id *id)
+{
+	struct tb_apple_port *tap;
+	acpi_status status;
+	int ret;
+
+	tap = devm_kzalloc(&port->dev, sizeof(*tap), GFP_KERNEL);
+	if (!tap)
+		return -ENOMEM;
+
+	if (!tb_apple_find(port, tap))
+		return -ENODEV;
+
+	pci_set_drvdata(port, tap);
+	tb_apple_hold_bridges(tap, true);
+
+	tb_apple_wrap_buses(tap);
+
+	status = acpi_install_notify_handler(ACPI_HANDLE(&tap->nhi->dev),
+					     ACPI_SYSTEM_NOTIFY,
+					     tb_apple_notify, tap);
+	if (ACPI_FAILURE(status)) {
+		tb_apple_unwrap_buses(tap);
+		tb_apple_hold_bridges(tap, false);
+		return -EIO;
+	}
+
+	/* PME polling needs active bridges, the port follows NHI and xHCI. */
+	pm_suspend_ignore_children(&port->dev, true);
+	ret = tb_apple_link(tap, tap->xhci, tap->nhi, 0);
+	if (!ret)
+		ret = tb_apple_link(tap, tap->nhi, port, 1);
+	if (!ret)
+		ret = tb_apple_link(tap, tap->xhci, port, 2);
+	if (ret) {
+		tb_apple_unlink(tap);
+		acpi_remove_notify_handler(ACPI_HANDLE(&tap->nhi->dev),
+					   ACPI_SYSTEM_NOTIFY, tb_apple_notify);
+		tb_apple_unwrap_buses(tap);
+		tb_apple_hold_bridges(tap, false);
+		return ret;
+	}
+
+	pm_runtime_set_autosuspend_delay(&port->dev, TB_APPLE_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(&port->dev);
+	pm_runtime_mark_last_busy(&port->dev);
+	pm_runtime_put_autosuspend(&port->dev);
+	pm_runtime_allow(&port->dev);
+
+	pci_info(port, "Thunderbolt runtime power control enabled\n");
+	return 0;
+}
+
+static void tb_apple_remove(struct pci_dev *port)
+{
+	struct tb_apple_port *tap = pci_get_drvdata(port);
+
+	pm_runtime_forbid(&port->dev);
+	pm_runtime_get_noresume(&port->dev);
+	pm_runtime_dont_use_autosuspend(&port->dev);
+
+	tb_apple_unlink(tap);
+	pm_suspend_ignore_children(&port->dev, false);
+
+	acpi_remove_notify_handler(ACPI_HANDLE(&tap->nhi->dev),
+				   ACPI_SYSTEM_NOTIFY, tb_apple_notify);
+	tb_apple_unwrap_buses(tap);
+	tb_apple_hold_bridges(tap, false);
+}
+
+static const struct pci_device_id tb_apple_ids[] = {
+	{
+		.vendor = PCI_VENDOR_ID_INTEL, .device = PCI_ANY_ID,
+		.subvendor = PCI_ANY_ID, .subdevice = PCI_ANY_ID,
+		.class = PCI_CLASS_BRIDGE_PCI_NORMAL, .class_mask = ~0,
+	},
+	{ }
+};
+
+static struct pci_driver tb_apple_driver = {
+	.name = "thunderbolt-apple-power",
+	.id_table = tb_apple_ids,
+	.probe = tb_apple_probe,
+	.remove = tb_apple_remove,
+	.driver.pm = &tb_apple_pm_ops,
+};
+
+/* Router runtime suspend stops the xHCI behind the same link controller. */
+bool tb_apple_usb_busy(struct tb_nhi *nhi)
+{
+	struct pci_dev *dsb = pci_upstream_bridge(to_pci_dev(nhi->dev));
+	struct pci_dev *upsb = dsb ? pci_upstream_bridge(dsb) : NULL;
+	struct pci_dev *xhci;
+
+	xhci = tb_apple_child(tb_apple_child(upsb, TB_APPLE_DSB_XHCI),
+			      PCI_DEVFN(0, 0));
+	if (!xhci)
+		return false;
+
+	return !pm_runtime_suspended(&xhci->dev) ||
+	       usb_for_each_dev(&xhci->dev, tb_apple_usb_dev);
+}
+
+bool tb_apple_host_rpm(struct tb_nhi *nhi)
+{
+	struct pci_dev *pdev = to_pci_dev(nhi->dev);
+
+	if (!x86_apple_machine)
+		return false;
+
+	if (pdev->device != PCI_DEVICE_ID_INTEL_TITAN_RIDGE_2C_NHI &&
+	    pdev->device != PCI_DEVICE_ID_INTEL_TITAN_RIDGE_4C_NHI)
+		return false;
+
+	return acpi_has_method(ACPI_HANDLE(nhi->dev), "RTPC");
+}
+
+#define TB_APPLE_MAX_PORTS	4
+
+static struct pci_dev *tb_apple_ports[TB_APPLE_MAX_PORTS];
+
+/* pcieport has no service on these root ports, take them over. */
+static void tb_apple_take_ports(void)
+{
+	struct tb_apple_port tap;
+	struct pci_dev *pdev = NULL;
+	int n = 0;
+
+	while (n < TB_APPLE_MAX_PORTS &&
+	       (pdev = pci_get_class(PCI_CLASS_BRIDGE_PCI_NORMAL, pdev))) {
+		if (!tb_apple_find(pdev, &tap))
+			continue;

+
+static void tb_apple_return_ports(void)
+{
+	int i;
+
+	for (i = 0; i < TB_APPLE_MAX_PORTS && tb_apple_ports[i]; i++) {
+		device_set_driver_override(&tb_apple_ports[i]->dev, NULL);
+		if (device_attach(&tb_apple_ports[i]->dev) < 0)
+			pci_warn(tb_apple_ports[i], "cannot rebind pcieport\n");
+		pci_dev_put(tb_apple_ports[i]);
+		tb_apple_ports[i] = NULL;
+	}
+}
+
+int tb_apple_power_init(void)
+{
+	int ret;
+
+	if (!x86_apple_machine)
+		return 0;
+
+	tb_apple_take_ports();
+	pci_lock_rescan_remove();
+	ret = pci_register_driver(&tb_apple_driver);
+	pci_unlock_rescan_remove();
+	if (ret)
+		tb_apple_return_ports();
+	return ret;
+}
+
+void tb_apple_power_exit(void)
+{
+	if (!x86_apple_machine)
+		return;
+
+	pci_lock_rescan_remove();
+	pci_unregister_driver(&tb_apple_driver);
+	pci_unlock_rescan_remove();
+	tb_apple_return_ports();
+}

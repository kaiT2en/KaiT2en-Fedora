@@ -27,13 +27,18 @@
 #include <linux/rtnetlink.h>
 #include <linux/skbuff.h>
 #include <linux/unaligned.h>
+#include <net/netlink.h>
+#include <brcm_hw_ids.h>
 
 #include "core.h"
 #include "debug.h"
 #include "feature.h"
 #include "fwil.h"
 #include "fwil_types.h"
+#include "bus.h"
 #include "proto.h"
+#include "cfg80211.h"

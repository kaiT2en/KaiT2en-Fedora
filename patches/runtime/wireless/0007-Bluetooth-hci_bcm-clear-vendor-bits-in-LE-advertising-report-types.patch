From: Andre Eikmeyer <dev@deq.rocks>
Subject: [PATCH] Bluetooth: hci_bcm: clear vendor bits in LE advertising report types

The BCM4364B0 of the MacBookPro15,1 sets bits 4, 5 and 7 of the event
type in LE Advertising Report events. A btmon capture shows types 0x10,
0x13, 0x14, 0x20, 0x23, 0x24, 0x93 and 0xa0 next to plain 0x00, 0x03 and
0x04, the same advertiser shows up as 0x13, 0x23 and 0x03.
process_adv_report() drops every type above 0x04 with "Unknown
advertising packet type", so most advertisements never reach the host.
With duplicate filtering in the controller a device is reported once per
discovery cycle of about 10.6 s. An AirDrop sender was reported as 0x23,
0x23 and 0x13 and only the fourth report, 0x03, reached BlueZ 32 s after
the first one.

Clear the bits above the type on Apple machines before the event goes to
the core.

Signed-off-by: Andre Eikmeyer <dev@deq.rocks>
---
--- a/drivers/bluetooth/hci_bcm.c
+++ b/drivers/bluetooth/hci_bcm.c
@@ -148,6 +148,7 @@
 	bool			no_uart_clock_set;
 	bool			use_autobaud_mode;
 	bool			acl_priority;
+	bool			adv_type_fixup;
 	u8			pcm_int_params[5];
 	u32			max_autobaud_speed;
 };
@@ -681,11 +682,42 @@
 	.lsize = 0, \
 	.maxlen = BCM_TYPE52_SIZE
 
+/* The BCM4364 of the MacBookPro15,1 sets bits above the event type of LE
+ * Advertising Reports, 0x13 and 0x23 for ADV_NONCONN_IND for example. The
+ * core drops reports of unknown types, so clear them.
+ */
+static void bcm_fixup_adv_report(struct sk_buff *skb)
+{
+	struct hci_event_hdr *hdr = (void *)skb->data;
+	struct hci_ev_le_advertising_info *info;
+	u8 *p, *end;
+	u8 num;
+
+	if (skb->len < HCI_EVENT_HDR_SIZE + 2 || hdr->evt != HCI_EV_LE_META)
+		return;
+
+	p = skb->data + HCI_EVENT_HDR_SIZE;
+	if (p[0] != HCI_EV_LE_ADVERTISING_REPORT)
+		return;
+
+	num = p[1];
+	p += 2;
+	end = skb->data + skb->len;
+	while (num-- && p + sizeof(*info) + 1 <= end) {
+		info = (void *)p;
+		info->type &= 0x0f;
+		p += sizeof(*info) + info->length + 1;
+	}
+}
+
 static int bcm_recv_event(struct hci_dev *hdev, struct sk_buff *skb)
 {
 	struct hci_uart *hu = hci_get_drvdata(hdev);
 	struct bcm_data *bcm = hu->priv;
 
+	if (bcm->dev && bcm->dev->adv_type_fixup)
+		bcm_fixup_adv_report(skb);
+
 	if (bcm->dev && bcm->dev->acl_priority)
 		btbcm_set_acl_priority_on_connect(hdev, skb);
 
@@ -1100,6 +1132,7 @@
 
 	if (x86_apple_machine && !bcm_apple_get_resources(dev)) {
 		dev->acl_priority = true;
+		dev->adv_type_fixup = true;
 		return 0;
 	}
 

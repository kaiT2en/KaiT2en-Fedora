From a23ee4f7f7c311a75d57bbebd87a1203cb1ad985 Mon Sep 17 00:00:00 2001
From: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
Date: Sun, 18 Oct 2026 21:22:46 -0400
Subject: [PATCH] drm/amd/pm: Remove UMC CDR Workaround for Apple systems

The workaround does nothing on apple macs, and when using
apple firmware it gives errors like:

amdgpu 0000:03:00.0: SMU: unknown command msg_reg: 50 resp_reg: fe

As the apple firmware does not recognize the command.

Signed-off-by: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
---
 drivers/gpu/drm/amd/pm/swsmu/smu11/navi10_ppt.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu11/navi10_ppt.c b/drivers/gpu/drm/amd/pm/swsmu/smu11/navi10_ppt.c
--- a/drivers/gpu/drm/amd/pm/swsmu/smu11/navi10_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu11/navi10_ppt.c
@@ -2640,6 +2640,9 @@ static bool navi10_need_umc_cdr_workarou
 	if (!smu_cmn_feature_is_enabled(smu, SMU_FEATURE_DPM_UCLK_BIT))
 		return false;
 
+	if (adev->pdev->subsystem_vendor == 0x106B)
+		return false;
+
 	if (amdgpu_ip_version(adev, MP1_HWIP, 0) == IP_VERSION(11, 0, 0) ||
 	    amdgpu_ip_version(adev, MP1_HWIP, 0) == IP_VERSION(11, 0, 5))
 		return true;

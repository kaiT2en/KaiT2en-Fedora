# macOS-style KaiT2en boot splash.
#
# plymouthd runs with DeviceScale=1 (see install-plymouth-theme.sh), so the
# window is measured in physical pixels. Every element is sized relative to
# a 1440x900 design canvas, which keeps the proportions identical on any
# panel or firmware framebuffer resolution.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

design_w = 1440;
design_h = 900;

boot.source_image = Image("boot.png");
boot.design_size = 116;

progress_box.source_image = Image("progress_box.png");
progress_bar.source_image = Image("progress_bar.png");
progress_box.design_w = 100;
progress_box.design_h = 4;
progress_value = 0;

kait2en.source_image = Image("watermark.png");
kait2en.design_w = 90;
kait2en.design_h = 24;
kait2en.design_margin = 24;

boot.sprite = Sprite();
progress_box.sprite = Sprite();
progress_bar.sprite = Sprite();
kait2en.sprite = Sprite();
kait2en.sprite.SetOpacity(0.55);

message.sprite = Sprite();
message.text = "";

dialog.status = "hidden";

ratio = 1;
last_win_w = 0;
last_win_h = 0;

fun scaled(image, design_w, design_h)
{
  w = Math.Int(design_w * ratio + 0.5);
  h = Math.Int(design_h * ratio + 0.5);
  if (w < 1)
    w = 1;
  if (h < 1)
    h = 1;
  return image.Scale(w, h);
}

fun update_progress_bar()
{
  width = Math.Int(progress_bar.full_image.GetWidth() * progress_value);
  if (width < 1)
    width = 1;

  progress_bar.image = progress_bar.full_image.Scale(
    width,
    progress_bar.full_image.GetHeight()
  );
  progress_bar.sprite.SetImage(progress_bar.image);
}

fun update_message()
{
  if (message.text == "")
    return;

  font_size = Math.Int(11 * ratio + 0.5);
  message.image = Image.Text(message.text, 0.85, 0.85, 0.85, 1, "Sans " + font_size);
  message.sprite.SetImage(message.image);
}

fun scale_images()
{
  boot.image = scaled(boot.source_image, boot.design_size, boot.design_size);
  boot.sprite.SetImage(boot.image);

  progress_box.image = scaled(progress_box.source_image, progress_box.design_w, progress_box.design_h);
  progress_box.sprite.SetImage(progress_box.image);

  progress_bar.full_image = scaled(progress_bar.source_image, progress_box.design_w, progress_box.design_h);
  update_progress_bar();

  kait2en.image = scaled(kait2en.source_image, kait2en.design_w, kait2en.design_h);
  kait2en.sprite.SetImage(kait2en.image);

  if (dialog.box_sprite)
  {
    dialog.box_image = scaled(dialog.box_source_image, 145, 39);
    dialog.lock_image = scaled(dialog.lock_source_image, 20.5, 22);
    dialog.entry_image = scaled(dialog.entry_source_image, 100, 15);
    dialog.bullet_image = scaled(dialog.bullet_source_image, 3.5, 3.5);

    dialog.box_sprite.SetImage(dialog.box_image);
    dialog.lock_sprite.SetImage(dialog.lock_image);
    dialog.entry_sprite.SetImage(dialog.entry_image);
    for (index = 0; dialog.bullets[index]; index++)
      dialog.bullets[index].SetImage(dialog.bullet_image);
  }

  update_message();
}

fun update_layout()
{
  win_w = Window.GetWidth();
  win_h = Window.GetHeight();
  win_x = Window.GetX();
  win_y = Window.GetY();

  if (win_w == last_win_w && win_h == last_win_h)
    return;

  last_win_w = win_w;
  last_win_h = win_h;

  ratio = win_w / design_w;
  if (win_h / design_h < ratio)
    ratio = win_h / design_h;

  scale_images();

  # Match Apple's startup composition: centered logo, low progress bar.
  boot.x = win_x + win_w / 2 - boot.image.GetWidth() / 2;
  boot.y = win_y + win_h * 0.5 - boot.image.GetHeight() / 2;
  boot.sprite.SetPosition(boot.x, boot.y, 10);

  progress_box.x = win_x + win_w / 2 - progress_box.image.GetWidth() / 2;
  progress_box.y = win_y + win_h * 0.9 - progress_box.image.GetHeight() / 2;
  progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 10);

  progress_bar.sprite.SetPosition(progress_box.x, progress_box.y, 11);

  margin = kait2en.design_margin * ratio;
  kait2en.x = win_x + win_w - kait2en.image.GetWidth() - margin;
  kait2en.y = win_y + win_h - kait2en.image.GetHeight() - margin;
  kait2en.sprite.SetPosition(kait2en.x, kait2en.y, 10);

  if (dialog.box_sprite)
  {
    dialog.box_x = win_x + win_w / 2 - dialog.box_image.GetWidth() / 2;
    dialog.box_y = win_y + win_h / 2 - dialog.box_image.GetHeight() / 2;
    dialog.box_sprite.SetPosition(dialog.box_x, dialog.box_y, 100);

    dialog.lock_x = dialog.box_x + 11 * ratio;
    dialog.lock_y = dialog.box_y + dialog.box_image.GetHeight() / 2 - dialog.lock_image.GetHeight() / 2;
    dialog.lock_sprite.SetPosition(dialog.lock_x, dialog.lock_y, 101);

    dialog.entry_x = dialog.lock_x + dialog.lock_image.GetWidth() + 6 * ratio;
    dialog.entry_y = dialog.box_y + dialog.box_image.GetHeight() / 2 - dialog.entry_image.GetHeight() / 2;
    dialog.entry_sprite.SetPosition(dialog.entry_x, dialog.entry_y, 101);

    for (index = 0; dialog.bullets[index]; index++)
    {
      bullet_x = dialog.entry_x + 4 * ratio + index * dialog.bullet_image.GetWidth();
      bullet_y = dialog.entry_y + dialog.entry_image.GetHeight() / 2 - dialog.bullet_image.GetHeight() / 2;
      dialog.bullets[index].SetPosition(bullet_x, bullet_y, 102);
    }
  }

  if (message.image)
  {
    message.x = win_x + win_w / 2 - message.image.GetWidth() / 2;
    message.y = progress_box.y + 14 * ratio;
    message.sprite.SetPosition(message.x, message.y, 50);
  }
}

update_layout();

fun refresh_callback()
{
  update_layout();
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress)
{
  progress_value = progress;
  update_progress_bar();
}

Plymouth.SetBootProgressFunction(progress_callback);

fun dialog_setup()
{
  dialog.box_source_image = Image("box.png");
  dialog.lock_source_image = Image("lock.png");
  dialog.entry_source_image = Image("entry.png");
  dialog.bullet_source_image = Image("bullet.png");

  dialog.box_sprite = Sprite();
  dialog.lock_sprite = Sprite();
  dialog.entry_sprite = Sprite();

  last_win_w = 0;
  update_layout();
}

fun dialog_set_opacity(opacity)
{
  if (!dialog.box_sprite)
    return;

  dialog.box_sprite.SetOpacity(opacity);
  dialog.lock_sprite.SetOpacity(opacity);
  dialog.entry_sprite.SetOpacity(opacity);
  for (index = 0; dialog.bullets[index]; index++)
    dialog.bullets[index].SetOpacity(opacity);
}

fun display_normal_callback()
{
  if (dialog.status != "hidden")
  {
    boot.sprite.SetOpacity(1);
    progress_box.sprite.SetOpacity(1);
    progress_bar.sprite.SetOpacity(1);
    dialog_set_opacity(0);
    dialog.status = "hidden";
  }
}

fun display_password_callback(prompt, bullets)
{
  if (!dialog.box_sprite)
    dialog_setup();

  dialog_set_opacity(1);
  dialog.status = "visible";
  boot.sprite.SetOpacity(0);
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);

  for (index = 0; dialog.bullets[index] || index < bullets; index++)
  {
    if (!dialog.bullets[index])
      dialog.bullets[index] = Sprite(dialog.bullet_image);

    if (index < bullets)
      dialog.bullets[index].SetOpacity(1);
    else
      dialog.bullets[index].SetOpacity(0);
  }

  last_win_w = 0;
  update_layout();
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_message_callback(text)
{
  message.text = text;
  update_message();
  message.x = Window.GetX() + Window.GetWidth() / 2 - message.image.GetWidth() / 2;
  message.y = progress_box.y + 14 * ratio;
  message.sprite.SetPosition(message.x, message.y, 50);
  message.sprite.SetOpacity(1);
}

fun hide_message_callback(text)
{
  message.sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# KaiT2en boot splash in the KaiT2en Vornehm style.
#
# plymouthd runs with DeviceScale=1 (see install-plymouth-theme.sh), so the
# window is measured in physical pixels. Every element is sized relative to
# a 1440x900 design canvas, which keeps the proportions identical on any
# panel or firmware framebuffer resolution.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

design_w = 1440;
design_h = 900;

boot.source_image = Image("boot.png");
boot.design_size = 116;

# The installer resolves the configured XKB layout and variant to its display name.
keyboard_layout_label = "English (US)";

progress_box.source_image = Image("progress_box.png");
progress_bar.source_image = Image("progress_bar.png");
progress_box.design_w = 200;
progress_box.design_h = 4;
progress_value = 0;

boot.sprite = Sprite();
progress_box.sprite = Sprite();
progress_bar.sprite = Sprite();

message.sprite = Sprite();
message.text = "";

dialog.status = "hidden";

ratio = 1;
last_win_w = 0;
last_win_h = 0;

fun scaled(image, design_w, design_h)
{
  w = Math.Int(design_w * ratio + 0.5);
  h = Math.Int(design_h * ratio + 0.5);
  if (w < 1)
    w = 1;
  if (h < 1)
    h = 1;
  return image.Scale(w, h);
}

fun update_progress_bar()
{
  width = Math.Int(progress_bar.full_image.GetWidth() * progress_value);
  if (width < 1)
    width = 1;

  progress_bar.image = progress_bar.full_image.Scale(
    width,
    progress_bar.full_image.GetHeight()
  );
  progress_bar.sprite.SetImage(progress_bar.image);
}

fun update_message()
{
  if (message.text == "")
    return;

  font_size = Math.Int(11 * ratio + 0.5);
  message.image = Image.Text(message.text, 0.85, 0.85, 0.85, 1, "Sans " + font_size);
  message.sprite.SetImage(message.image);
}

fun scale_images()
{
  boot.image = scaled(boot.source_image, boot.design_size, boot.design_size);
  boot.sprite.SetImage(boot.image);

  progress_box.image = scaled(progress_box.source_image, progress_box.design_w, progress_box.design_h);
  progress_box.sprite.SetImage(progress_box.image);

  progress_bar.full_image = scaled(progress_bar.source_image, progress_box.design_w, progress_box.design_h);
  update_progress_bar();

  if (dialog.entry_sprite)
  {
    dialog.entry_image = scaled(dialog.entry_source_image, 305, 34);
    dialog.bullet_image = scaled(dialog.bullet_source_image, 7.5, 7.5);
    dialog.bullet_gap = 5 * ratio;
    dialog.bullet_left_padding = 46 * ratio;
    dialog.bullet_right_padding = 20 * ratio;
    dialog.bullet_capacity = Math.Int(
      (dialog.entry_image.GetWidth() - dialog.bullet_left_padding - dialog.bullet_right_padding + dialog.bullet_gap) /
      (dialog.bullet_image.GetWidth() + dialog.bullet_gap)
    );
    if (dialog.bullet_capacity < 1)
      dialog.bullet_capacity = 1;
    dialog.visible_bullet_count = dialog.bullet_count;
    if (dialog.visible_bullet_count > dialog.bullet_capacity)
      dialog.visible_bullet_count = dialog.bullet_capacity;
    dialog.lock_image = scaled(dialog.lock_source_image, 18, 18);
    dialog.keyboard_image = scaled(dialog.keyboard_source_image, 20, 20);
    dialog.prompt_image = Image.Text(dialog.prompt_text, 0.96, 0.96, 0.96, 1, "Cantarell " + Math.Int(12 * ratio + 0.5));
    dialog.layout_image = Image.Text(keyboard_layout_label, 0.96, 0.96, 0.96, 1, "Cantarell " + Math.Int(12 * ratio + 0.5));

    dialog.entry_sprite.SetImage(dialog.entry_image);
    dialog.lock_sprite.SetImage(dialog.lock_image);
    dialog.prompt_sprite.SetImage(dialog.prompt_image);
    dialog.keyboard_sprite.SetImage(dialog.keyboard_image);
    dialog.layout_sprite.SetImage(dialog.layout_image);
    for (index = 0; dialog.bullets[index]; index++)
      dialog.bullets[index].SetImage(dialog.bullet_image);
  }

  update_message();
}

fun update_layout()
{
  win_w = Window.GetWidth();
  win_h = Window.GetHeight();
  win_x = Window.GetX();
  win_y = Window.GetY();

  if (win_w == last_win_w && win_h == last_win_h)
    return;

  last_win_w = win_w;
  last_win_h = win_h;

  ratio = win_w / design_w;
  if (win_h / design_h < ratio)
    ratio = win_h / design_h;

  scale_images();

  # Apple's startup composition with the KaiT2en kanji in place of the
  # logo: centered mark, low progress bar, nothing else on screen.
  boot.x = win_x + win_w / 2 - boot.image.GetWidth() / 2;
  boot.y = win_y + win_h * 0.5 - boot.image.GetHeight() / 2;
  boot.sprite.SetPosition(boot.x, boot.y, 10);

  progress_box.x = win_x + win_w / 2 - progress_box.image.GetWidth() / 2;
  progress_box.y = win_y + win_h * 0.9 - progress_box.image.GetHeight() / 2;
  progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 10);

  progress_bar.sprite.SetPosition(progress_box.x, progress_box.y, 11);

  if (dialog.entry_sprite)
  {
    dialog.entry_x = win_x + win_w / 2 - dialog.entry_image.GetWidth() / 2;
    dialog.entry_y = boot.y + boot.image.GetHeight() / 2 + 116 * ratio;
    dialog.entry_sprite.SetPosition(dialog.entry_x, dialog.entry_y, 100);
    dialog.lock_sprite.SetPosition(dialog.entry_x + 10 * ratio, dialog.entry_y + dialog.entry_image.GetHeight() / 2 - dialog.lock_image.GetHeight() / 2, 101);

    dialog.prompt_x = win_x + win_w / 2 - dialog.prompt_image.GetWidth() / 2;
    dialog.prompt_y = dialog.entry_y + dialog.entry_image.GetHeight() + 8 * ratio;
    dialog.prompt_sprite.SetPosition(dialog.prompt_x, dialog.prompt_y, 100);

    layout_gap = 8 * ratio;
    dialog.layout_width = dialog.keyboard_image.GetWidth() + layout_gap + dialog.layout_image.GetWidth();
    dialog.layout_x = win_x + win_w / 2 - dialog.layout_width / 2;
    dialog.layout_y = dialog.prompt_y + dialog.prompt_image.GetHeight() + 9 * ratio;
    dialog.keyboard_sprite.SetPosition(dialog.layout_x, dialog.layout_y + dialog.layout_image.GetHeight() / 2 - dialog.keyboard_image.GetHeight() / 2, 100);
    dialog.layout_sprite.SetPosition(dialog.layout_x + dialog.keyboard_image.GetWidth() + layout_gap, dialog.layout_y, 100);

    for (index = 0; dialog.bullets[index]; index++)
    {
      bullet_x = dialog.entry_x + dialog.entry_image.GetWidth() - dialog.bullet_right_padding - dialog.bullet_image.GetWidth() - (dialog.visible_bullet_count - 1) * (dialog.bullet_image.GetWidth() + dialog.bullet_gap) + index * (dialog.bullet_image.GetWidth() + dialog.bullet_gap);
      bullet_y = dialog.entry_y + dialog.entry_image.GetHeight() / 2 - dialog.bullet_image.GetHeight() / 2;
      dialog.bullets[index].SetPosition(bullet_x, bullet_y, 102);
    }
  }

  if (message.image)
  {
    message.x = win_x + win_w / 2 - message.image.GetWidth() / 2;
    message.y = progress_box.y + 14 * ratio;
    message.sprite.SetPosition(message.x, message.y, 50);
  }
}

update_layout();

fun refresh_callback()
{
  update_layout();
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress)
{
  progress_value = progress;
  update_progress_bar();
}

Plymouth.SetBootProgressFunction(progress_callback);

fun dialog_setup()
{
  dialog.lock_source_image = Image("lock.png");
  dialog.entry_source_image = Image("entry.png");
  dialog.bullet_source_image = Image("bullet.png");
  dialog.keyboard_source_image = Image("keyboard.png");

  dialog.entry_sprite = Sprite();
  dialog.lock_sprite = Sprite();
  dialog.prompt_sprite = Sprite();
  dialog.keyboard_sprite = Sprite();
  dialog.layout_sprite = Sprite();
  dialog.bullet_count = 0;
  dialog.visible_bullet_count = 0;

  last_win_w = 0;
  update_layout();
}

fun dialog_set_opacity(opacity)
{
  if (!dialog.entry_sprite)
    return;

  dialog.entry_sprite.SetOpacity(opacity);
  dialog.lock_sprite.SetOpacity(opacity);
  dialog.prompt_sprite.SetOpacity(opacity);
  dialog.keyboard_sprite.SetOpacity(opacity);
  dialog.layout_sprite.SetOpacity(opacity);
  for (index = 0; dialog.bullets[index]; index++)
    dialog.bullets[index].SetOpacity(opacity);
}

fun display_normal_callback()
{
  if (dialog.status != "hidden")
  {
    boot.sprite.SetOpacity(1);
    progress_box.sprite.SetOpacity(1);
    progress_bar.sprite.SetOpacity(1);
    dialog_set_opacity(0);
    dialog.status = "hidden";
  }
}

fun display_password_callback(prompt, bullets)
{
  dialog.prompt_text = prompt;
  if (!dialog.entry_sprite)
    dialog_setup();

  dialog_set_opacity(1);
  dialog.status = "visible";
  # Keep the entered password unrestricted, but never draw bullets beyond the
  # width of the entry field.
  dialog.bullet_count = bullets;
  dialog.visible_bullet_count = dialog.bullet_count;
  if (dialog.visible_bullet_count > dialog.bullet_capacity)
    dialog.visible_bullet_count = dialog.bullet_capacity;
  boot.sprite.SetOpacity(1);
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);

  for (index = 0; dialog.bullets[index] || index < dialog.visible_bullet_count; index++)
  {
    if (!dialog.bullets[index])
      dialog.bullets[index] = Sprite(dialog.bullet_image);

    if (index < dialog.visible_bullet_count)
      dialog.bullets[index].SetOpacity(1);
    else
      dialog.bullets[index].SetOpacity(0);
  }

  last_win_w = 0;
  update_layout();
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_message_callback(text)
{
  message.text = text;
  update_message();
  message.x = Window.GetX() + Window.GetWidth() / 2 - message.image.GetWidth() / 2;
  message.y = progress_box.y + 14 * ratio;
  message.sprite.SetPosition(message.x, message.y, 50);
  message.sprite.SetOpacity(1);
}

fun hide_message_callback(text)
{
  message.sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

[Unit]
Description=T2 Touch Bar
After=graphical-session.target
PartOf=graphical-session.target
# GDM and users outside the group keep the native Touch Bar
ConditionGroup=kait2en-touchbar
# The panel unit switches the Touch Bar to the display first and back once
# the daemon is gone. The sandbox below allows only one process per unit.
Requires=kait2en-touchbar-panel.service
After=kait2en-touchbar-panel.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/kait2en-touchbar
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
PrivateIPC=true
ProtectKernelTunables=true
ReadWritePaths=-/sys/class/backlight/t2tb_backlight/brightness
ReadWritePaths=-/sys/class/backlight/appletb_backlight/brightness
ReadWritePaths=-/sys/module/t2_trackpad_actuator/parameters/play
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target

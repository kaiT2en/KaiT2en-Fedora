[Unit]
Description=Attach the Apple T2 Touch Bar display interface

[Service]
Type=oneshot
# Started by udev when the panel comes up on Apple's firmware row, at boot
# and after resume. It only switches the panel while a graphical session of a
# kait2en-touchbar member runs the daemon. Until then TTY and GDM keep the
# native Touch Bar.
ExecCondition=/usr/bin/systemctl --global is-enabled --quiet kait2en-touchbar.service
ExecCondition=/usr/bin/systemctl is-active --quiet kait2en-touchbar-session@*.service
ExecStart=/usr/local/bin/kait2en-touchbar --attach
TimeoutStartSec=60
Restart=on-failure
RestartSec=5

// Members of kait2en-touchbar may start and stop the root unit that switches
// the Touch Bar between Apple's firmware row and the display. Their user
// service does that when the graphical session starts and ends.
polkit.addRule(function(action, subject) {
	if (action.id != "org.freedesktop.systemd1.manage-units" ||
	    !subject.isInGroup("kait2en-touchbar"))
		return polkit.Result.NOT_HANDLED;
	var unit = action.lookup("unit");
	var verb = action.lookup("verb");
	if (/^kait2en-touchbar-session@[0-9]+\.service$/.test(unit) &&
	    (verb == "start" || verb == "stop"))
		return polkit.Result.YES;
	return polkit.Result.NOT_HANDLED;
});

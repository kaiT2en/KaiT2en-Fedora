<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>KaiT2en</vendor>
  <vendor_url>https://kait2en.github.io/</vendor_url>
  <action id="org.t2powerexplorer.status">
    <description>Read privileged display power diagnostics</description>
    <message>Authentication is required to inspect display power diagnostics</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/t2-power-explorer-status</annotate>
  </action>
</policyconfig>
